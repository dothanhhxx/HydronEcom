# Cổng chạy API Backend
PORT=4000
HOST=0.0.0.0

# Khóa bí mật cho quản trị viên và phiên HMAC
# Để trống khi chạy local; production bắt buộc ≥ 12 ký tự và không dùng lại mật khẩu cũ
ADMIN_SECRET_KEY=

# Cho phép CORS từ frontend
CORS_ORIGIN=http://localhost:3000

# Webhook thông báo đơn hàng / tin nhắn (tùy chọn)
HYDRON_WEBHOOK_URL=

# Database + lưu ảnh trên Supabase (để trống thì dùng file trong data/ và uploads/)
# Lấy ở Supabase → Project Settings → API. service_role là khoá bí mật, chỉ dùng ở backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=products

# Database + lưu ảnh trên Appwrite Cloud (ưu tiên hơn Supabase nếu điền đủ PROJECT_ID + API_KEY)
# Lấy ở Appwrite Console → Overview (Project ID, API Endpoint) và Overview → API keys.
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=Ecommerce
APPWRITE_BUCKET_ID=products
